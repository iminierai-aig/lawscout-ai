# LawScout AI Environment Variables
# Copy this file to .env and fill in your values

# Qdrant Cloud (https://cloud.qdrant.io/)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Override Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-pro

# --- Auth / security (REQUIRED) ---
# JWT signing key. The app refuses to start without a real value.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_64_char_hex_secret
# Session middleware secret for OAuth (falls back to JWT_SECRET_KEY if unset)
# SESSION_SECRET=your_64_char_hex_secret

# Comma-separated emails allowed to call /api/auth/admin/* endpoints.
# If empty, all admin endpoints return 403 (locked down by default).
ADMIN_EMAILS=you@example.com

# Optional: shared store for rate limiting across workers (default: in-memory).
# RATELIMIT_STORAGE_URI=redis://localhost:6379
